[data.work]
  dirname = "{{ promptStringOnce . "work.dirname" "Enter your work folder name inside $HOME (e.g. work)" }}"
  email   = "{{ promptStringOnce . "work.email" "Enter your work email" }}"
  sshKey  = "{{ promptStringOnce . "work.sshKey" "Enter the filename of your work SSH private key in ~/.ssh (e.g. id_ed25519_work)" }}"

[data.artifactory]
  npmAuthUrl = "{{ promptStringOnce . "artifactory.npmAuthUrl" "Enter the artifactory npm auth URL (leave blank to skip artifactory setup)" "" }}"
  user       = "{{ promptStringOnce . "artifactory.user" "Enter your artifactory username" "" }}"
  apiToken   = "{{ promptStringOnce . "artifactory.apiToken" "Enter your artifactory API token" "" }}"
