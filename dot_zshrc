export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# oh-my-zsh normally initialises the zsh completion system (compinit), which defines
# compdef. Since we don't use oh-my-zsh but use its git plugin for aliases, a no-op stub is enough. 
compdef() {}

if [[ ! -f "$HOME/.fzf.zsh" ]] || [[ "$(which fzf)" -nt "$HOME/.fzf.zsh" ]]; then
  fzf --zsh > "$HOME/.fzf.zsh"
fi
source "$HOME/.fzf.zsh"


if [[ -d "$HOME/OpenSource/vcpkg" ]]; then
  export VCPKG_ROOT="$HOME/OpenSource/vcpkg"
fi

_cached_eval() {
  local cache="$HOME/.cache/zsh/${1:t}.zsh"
  [[ ! -f $cache || "$(command -v $1)" -nt $cache ]] && { mkdir -p "${cache:h}"; "$@" > $cache }
  source $cache
}

command -v mise &>/dev/null && _cached_eval mise activate zsh
command -v sheldon &>/dev/null && eval "$(sheldon source)" # Sheldon already caches
command -v starship &>/dev/null && _cached_eval starship init zsh

if [[ -n "$VIRTUAL_ENV" && ":$PATH:" != *":$VIRTUAL_ENV/bin:"* ]]; then
  export PATH="$VIRTUAL_ENV/bin:$PATH"
fi
